---
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 36, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#0B0E14" stroke="#262D3D" stroke-width="2"></rect>
    <rect x="13" y="12" width="8" height="40" rx="4" fill="#F5F1E8"></rect>
    <circle cx="33" cy="26" r="11" fill="none" stroke="#FF5B2E" stroke-width="8"></circle>
    <rect x="28.5" y="23" width="2.6" height="6" rx="1.3" fill="#F5F1E8"></rect>
    <rect x="31.7" y="20" width="2.6" height="12" rx="1.3" fill="#F5F1E8"></rect>
    <rect x="34.9" y="23" width="2.6" height="6" rx="1.3" fill="#F5F1E8"></rect>
  </svg>
  {
    wordmark && (
      <span class="word">
        <span class="small">The Practitioners</span>
        <span class="big">Pod</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .word {
    display: grid;
    line-height: 1;
  }
  .small {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
  }
  .big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    color: var(--paper);
  }
</style>
