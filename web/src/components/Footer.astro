---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, activePlatforms } from '../site.config';

const socials = (
  [
    ['linkedin', site.socials.linkedin, 'LinkedIn'],
    ['x', site.socials.x, 'X'],
    ['youtube', site.socials.youtube, 'YouTube'],
    ['instagram', site.socials.instagram, 'Instagram'],
  ] as const
).filter(([, url]) => url);
const year = new Date().getFullYear();
---

<footer>
  <div class="container cols">
    <div class="about">
      <Logo />
      <p>{site.tagline}<br />Hosted by <a href="/about">{site.host.name}</a>.</p>
      <div class="social">
        {
          socials.map(([icon, url, label]) => (
            <a href={url} target="_blank" rel="noopener" aria-label={label}>
              <Icon name={icon} />
            </a>
          ))
        }
        <a href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
      </div>
    </div>
    <div>
      <h4>Show</h4>
      <ul>
        <li><a href="/episodes">Episodes</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/rss.xml">Site RSS</a></li>
      </ul>
    </div>
    <div>
      <h4>Listen</h4>
      <ul>
        {activePlatforms.map((p) => <li><a href={p.url} target="_blank" rel="noopener">{p.label}</a></li>)}
        {activePlatforms.length === 0 && <li><a href="/#subscribe">Get launch updates</a></li>}
      </ul>
    </div>
    <div>
      <h4>Get involved</h4>
      <ul>
        <li><a href="/guest">Be a guest</a></li>
        <li><a href="/contact">Contact & sponsorship</a></li>
        <li><a href="/brand">Press & brand kit</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <span>© {year} {site.name}</span>
    <span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background: var(--ink-2);
    padding-top: 64px;
  }
  .cols {
    display: grid;
    gap: 40px;
    grid-template-columns: 1.6fr repeat(3, 1fr);
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  .about p {
    color: var(--muted);
    margin-top: 16px;
    font-size: 0.95rem;
  }
  h4 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  ul a {
    text-decoration: none;
    font-size: 0.95rem;
  }
  .social {
    display: flex;
    gap: 10px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--muted);
  }
  .social a:hover {
    color: var(--paper);
    border-color: var(--paper);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    padding-block: 28px;
    margin-top: 48px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .legal a {
    color: var(--muted);
  }
</style>
