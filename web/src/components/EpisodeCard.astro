---
import type { Episode } from '../lib/episodes';
import { epLabel, formatDate } from '../lib/episodes';

interface Props {
  episode: Episode;
}
const { episode } = Astro.props;
const { title, number, description, pubDate, duration, guests, youtubeId } = episode.data;
const thumb = youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : null;
---

<a href={`/episodes/${episode.id}`} class="ep card">
  <div class="thumb">
    {thumb ? <img src={thumb} alt="" loading="lazy" width="480" height="360" /> : <span class="num">{String(number).padStart(3, '0')}</span>}
  </div>
  <div class="meta mono">
    <span>{epLabel(number)}</span>
    <span>{formatDate(pubDate)}</span>
    {duration && <span>{duration}</span>}
  </div>
  <h3>{title}</h3>
  {guests.length > 0 && <p class="guests">with {guests.map((g) => g.name).join(', ')}</p>}
  <p class="desc">{description}</p>
</a>

<style>
  .ep {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .ep:hover {
    border-color: var(--signal);
    transform: translateY(-2px);
    color: inherit;
  }
  .thumb {
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 18px;
    background:
      radial-gradient(circle at 75% 30%, var(--signal-soft), transparent 60%),
      repeating-linear-gradient(90deg, transparent 0 23px, rgba(255, 255, 255, 0.03) 23px 24px),
      var(--ink-3);
    display: grid;
    place-items: center;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 4.5rem;
    letter-spacing: -0.05em;
    color: var(--paper);
    opacity: 0.9;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 10px;
  }
  .meta span:first-child {
    color: var(--signal);
  }
  h3 {
    margin-bottom: 6px;
  }
  .guests {
    color: var(--paper);
    font-size: 0.92rem;
    margin-bottom: 8px;
  }
  .desc {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
