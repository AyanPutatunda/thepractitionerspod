# Copy to .env.local for local work. Never commit .env.local or real values.
# v1 renders every public page with all of these empty.

# Canonical site URL. Production builds should use https://thepractitionerspod.com
# (also set in netlify.toml).
NEXT_PUBLIC_SITE_URL=

# Optional. Public episode sync uses YouTube's channel feed with no key.
# When set, the Data API adds duration and view count. Server-only.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Supabase. Leave empty until a project exists. /admin returns 404 without both.
# The anon key is public. The service role bypasses RLS and is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Not read by v1. Kept so later phases have a name list.
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_REFRESH_TOKEN=
NEXT_PUBLIC_CALCOM_LINK=
CALCOM_API_KEY=
