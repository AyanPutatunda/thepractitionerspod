# Copy to .env for local work. Never commit .env or real values.
# Prisma reads .env. Next.js reads .env and .env.local (.env.local wins).
# A dummy DATABASE_URL is enough for `prisma generate` and for a build with no database.

# Canonical site URL used for SEO and auth redirects.
NEXT_PUBLIC_SITE_URL=

# Supabase. Anon key is public. Service role bypasses RLS and is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the legacy Prisma client.
# Leave this unset in production once Prisma is removed.
DATABASE_URL=

# YouTube Data API v3. Sync runs server-side.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Resend. FROM_EMAIL is the verified sender. ADMIN_EMAIL receives form notifications.
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=

# Cloudflare Turnstile. Site key is public. Secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GA4 measurement id (public).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Calendar, if native two-way scheduling is chosen.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Cal.com, if the embed or API option is chosen instead of Google Calendar.
NEXT_PUBLIC_CALCOM_LINK=
CALCOM_API_KEY=
